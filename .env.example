# ИИ-анализ: локальная vision-модель через OpenAI-совместимый API (LM Studio / llama.cpp server / Ollama).
VLM_PROVIDER=local
VLM_URL=http://127.0.0.1:8000/v1
VLM_MODEL=vlm
# 1 — модель запущена отдельно (например, MTPLX); launch.sh не запускает LM Studio.
VLM_MANAGED_EXTERNALLY=0

# Пароли демо-учёток (необязательно). Пусто — при первом запуске создаются случайные,
# они видны на странице /setup на самом сервере и в data/demo-accounts.txt.
DEMO_PASSWORD_ENGINEER=
DEMO_PASSWORD_MASTER=
DEMO_PASSWORD_ADMIN=

# Папка с данными организаторов (паспорта, телеметрия). По умолчанию yandex/ в проекте или ../materials/yandex.
# Если в ней есть паспорта насосов AMS, их карточки сами добавятся в базу при запуске.
ORG_DATA_DIR=
# Отключить «размышления» reasoning-моделей (Qwen 3.x) — иначе ответ в разы дольше
VLM_REASONING_EFFORT=none

# Облачный Mistral — только для разработки (VLM_PROVIDER=mistral), на объекте не используется.
# MISTRAL_API_KEYS=mstrl_key1,mstrl_key2
# MISTRAL_MODEL=mistral-large-latest

# Детектор YOLO-World: auto — GPU (ROCm), если проходит проверку, иначе CPU; можно cpu / gpu
DETECTOR_DEVICE=auto

# Порты: приложение по HTTPS для телефонов (все интерфейсы) и HTTP только для самого ноутбука (localhost)
HTTPS_PORT=8080
HTTP_PORT=8081
